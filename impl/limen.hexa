// ════════════════════════════════════════════════════════════════════════════
//  impl/limen.hexa — `.limen` packed anchor-pack codec (pack / unpack), pure-hexa.
//
//  The normative REFERENCE encoder/decoder for spec/limen.md §1–§3 (the layer
//  spec/limen.md §6 marked "NOT WRITTEN"). A `.limen` file is a packed shard of
//  member anchors: header + length-prefixed @anchor records + trailing SHA-256
//  merkle root (a decodable pack, not an opaque blob — see spec/kosmos.md §5.6.3).
//
//  PUBLIC API:
//    sha256_bytes(b: [int]) -> [int]            — SHA-256 over a byte array (NUL-safe)
//    crc32_bytes(b: [int], n: int) -> int       — CRC-32/IEEE over b[0,n)
//    limen_merkle_root(leaves: [[int]]) -> [int]— spec §3 trailing root
//    limen_pack(members: [string]) -> [int]     — [@anchor text] -> .limen bytes
//    limen_unpack(bytes: [int]) -> [string]     — .limen bytes -> [@anchor text]
//    limen_verify(bytes: [int]) -> int          — spec §4 (1 = all checks pass)
//    limen_write(path: string, members: [string]) -> int   — emit a .limen file
//    limen_read(path: string) -> [string]       — load + unpack a .limen file
//
//  HARD CONSTRAINTS (matching impl/anima/kosmos_parser_lib.hexa):
//    - pure-hexa only (NO GPU, NO PyTorch). No main / no selftest (compiled-first
//      lib; the runnable check lives in impl/test_limen_roundtrip.hexa).
//    - bytes are [int] (0..255), NOT strings: hexa strings are C-string /
//      NUL-terminated at the runtime layer, so binary content (the header's LE
//      integers, raw 32-byte hashes, the merkle root) MUST ride [int] arrays.
//    - the hexa builtin sha256() is strlen-based — it truncates at the first NUL,
//      so it cannot hash the raw merkle-node bytes; this file carries a byte-array
//      SHA-256 (FIPS 180-4) verified against the FIPS "abc"/empty vectors + the
//      builtin on NUL-free inputs in test_limen_roundtrip.hexa.
//    - any array grown via `.push()` / any reassigned local is `let mut` (an
//      immutable `let` + `.push()` mis-lowers in the current runtime).
//
//  Disk I/O uses the `write_bytes(path, [int])` / `read_file_bytes(path) -> [int]`
//  builtins (both NUL-safe, unlike write_file/read_file which strlen-truncate).
//
//  SSOT: spec/limen.md (wire format) · spec/kosmos.md §5.6.3/§5.6.4 (member ref).
// ════════════════════════════════════════════════════════════════════════════


// ── byte-array append helpers (pushing to a param array propagates) ──
fn push_all(dst: [int], src: [int]) {
    let mut i = 0
    while i < len(src) { dst.push(src[i]); i = i + 1 }
}
fn push_u16(dst: [int], v: int) {
    dst.push(v & 0xFF); dst.push((v >> 8) & 0xFF)
}
fn push_u32(dst: [int], v: int) {
    dst.push(v & 0xFF); dst.push((v >> 8) & 0xFF)
    dst.push((v >> 16) & 0xFF); dst.push((v >> 24) & 0xFF)
}


// ── SHA-256 over a byte array ([int] 0..255 -> [int] 32), FIPS 180-4 ──
fn l_rotr(x: int, n: int) -> int { return ((x >> n) | (x << (32 - n))) & 0xFFFFFFFF }

pub fn sha256_bytes(msg_in: [int]) -> [int] {
    let mut h0 = 1779033703; let mut h1 = 3144134277; let mut h2 = 1013904242; let mut h3 = 2773480762
    let mut h4 = 1359893119; let mut h5 = 2600822924; let mut h6 = 528734635;  let mut h7 = 1541459225
    let K = [
        1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,
        3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,
        3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,
        2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,
        666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,
        2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,
        430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,
        1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298
    ]
    let mut data: [int] = []
    let mut i = 0
    while i < len(msg_in) { data.push(msg_in[i] & 0xFF); i = i + 1 }
    let bitlen = len(msg_in) * 8
    data.push(0x80)
    while (len(data) % 64) != 56 { data.push(0) }
    let mut bi = 7
    while bi >= 0 { data.push((bitlen >> (bi * 8)) & 0xFF); bi = bi - 1 }
    let nblocks = len(data) / 64
    let mut bk = 0
    while bk < nblocks {
        let mut w: [int] = []
        let mut t = 0
        while t < 16 {
            let o = bk * 64 + t * 4
            w.push(((data[o] << 24) | (data[o+1] << 16) | (data[o+2] << 8) | data[o+3]) & 0xFFFFFFFF)
            t = t + 1
        }
        while t < 64 {
            let v15 = w[t-15]; let v2 = w[t-2]
            let s0 = (l_rotr(v15, 7) ^ l_rotr(v15, 18) ^ (v15 >> 3)) & 0xFFFFFFFF
            let s1 = (l_rotr(v2, 17) ^ l_rotr(v2, 19) ^ (v2 >> 10)) & 0xFFFFFFFF
            w.push((w[t-16] + s0 + w[t-7] + s1) & 0xFFFFFFFF)
            t = t + 1
        }
        let mut a = h0; let mut b = h1; let mut c = h2; let mut d = h3
        let mut e = h4; let mut f = h5; let mut g = h6; let mut hh = h7
        let mut r = 0
        while r < 64 {
            let S1 = (l_rotr(e, 6) ^ l_rotr(e, 11) ^ l_rotr(e, 25)) & 0xFFFFFFFF
            let ch = ((e & f) ^ ((e ^ 0xFFFFFFFF) & g)) & 0xFFFFFFFF
            let t1 = (hh + S1 + ch + K[r] + w[r]) & 0xFFFFFFFF
            let S0 = (l_rotr(a, 2) ^ l_rotr(a, 13) ^ l_rotr(a, 22)) & 0xFFFFFFFF
            let maj = ((a & b) ^ (a & c) ^ (b & c)) & 0xFFFFFFFF
            let t2 = (S0 + maj) & 0xFFFFFFFF
            hh = g; g = f; f = e; e = (d + t1) & 0xFFFFFFFF
            d = c; c = b; b = a; a = (t1 + t2) & 0xFFFFFFFF
            r = r + 1
        }
        h0 = (h0 + a) & 0xFFFFFFFF; h1 = (h1 + b) & 0xFFFFFFFF; h2 = (h2 + c) & 0xFFFFFFFF; h3 = (h3 + d) & 0xFFFFFFFF
        h4 = (h4 + e) & 0xFFFFFFFF; h5 = (h5 + f) & 0xFFFFFFFF; h6 = (h6 + g) & 0xFFFFFFFF; h7 = (h7 + hh) & 0xFFFFFFFF
        bk = bk + 1
    }
    let hv = [h0, h1, h2, h3, h4, h5, h6, h7]
    let mut out: [int] = []
    let mut z = 0
    while z < 8 {
        out.push((hv[z] >> 24) & 0xFF); out.push((hv[z] >> 16) & 0xFF)
        out.push((hv[z] >> 8) & 0xFF);  out.push(hv[z] & 0xFF)
        z = z + 1
    }
    return out
}


// ── CRC-32 (IEEE 802.3, reflected poly 0xEDB88320) over b[0, n) ──
pub fn crc32_bytes(data: [int], n: int) -> int {
    let mut crc = 0xFFFFFFFF
    let mut i = 0
    while i < n {
        crc = crc ^ data[i]
        let mut j = 0
        while j < 8 {
            if (crc & 1) == 1 { crc = (crc >> 1) ^ 3988292384 }
            else { crc = crc >> 1 }
            j = j + 1
        }
        i = i + 1
    }
    return (crc ^ 0xFFFFFFFF) & 0xFFFFFFFF
}


// ── little-endian decoders + byte helpers ──
fn l_rd16(b: [int], o: int) -> int { return b[o] | (b[o+1] << 8) }
fn l_rd32(b: [int], o: int) -> int { return (b[o] | (b[o+1] << 8) | (b[o+2] << 16) | (b[o+3] << 24)) & 0xFFFFFFFF }

fn l_str_bytes(s: string) -> [int] {
    let mut r: [int] = []
    let mut i = 0
    while i < len(s) { r.push(char_code(s, i) & 0xFF); i = i + 1 }
    return r
}
fn l_bytes_str(b: [int]) -> string {
    let mut s = ""
    let mut i = 0
    while i < len(b) { s = s + chr(b[i]); i = i + 1 }
    return s
}
fn l_bytes_eq(a: [int], b: [int]) -> int {
    if len(a) != len(b) { return 0 }
    let mut i = 0
    while i < len(a) { if a[i] != b[i] { return 0 } i = i + 1 }
    return 1
}
fn l_slice(b: [int], a: int, z: int) -> [int] {
    let mut r: [int] = []
    let mut i = a
    while i < z { r.push(b[i]); i = i + 1 }
    return r
}


// ── merkle root over member leaf hashes (spec §3, RFC-6962-style domain sep) ──
//   leaf  = record.hash (= SHA-256(anchor_text), supplied by caller)
//   node  = SHA-256(0x01 || L || R)   ; odd level → duplicate the last node
//   count==0 → SHA-256("")   ; count==1 → the single leaf
pub fn limen_merkle_root(leaves: [[int]]) -> [int] {
    let n = len(leaves)
    if n == 0 { return sha256_bytes([]) }
    if n == 1 { return leaves[0] }
    let mut level: [[int]] = leaves
    while len(level) > 1 {
        let mut next: [[int]] = []
        let mut i = 0
        while i < len(level) {
            let lh = level[i]
            let mut rh = level[i]
            if (i + 1) < len(level) { rh = level[i+1] }
            let mut pre: [int] = [1]
            push_all(pre, lh)
            push_all(pre, rh)
            next.push(sha256_bytes(pre))
            i = i + 2
        }
        level = next
    }
    return level[0]
}


// ── pack (spec §1,§2): members = [anchor_text] -> .limen byte sequence ──
//   header[0,24) = magic(8) | vmaj(2) | vmin(2) | count(4) | flags(4) | crc32(4)
//   record       = SHA-256(text)(32) | anchor_len u32le(4) | anchor_text(len)
//   trailer      = merkle_root(32)
//   flags = 0 (members stored as-produced; the as-produced order is committed by
//   the trailing root). A producer MAY sort by hash + set bit0 — not done here.
pub fn limen_pack(members: [string]) -> [int] {
    let count = len(members)
    let mut out: [int] = [76, 73, 77, 69, 78, 0, 0, 0]   // magic "LIMEN\0\0\0"
    push_u16(out, 2)                      // version_major (this doc = 2)
    push_u16(out, 0)                      // version_minor
    push_u32(out, count)                  // count
    push_u32(out, 0)                      // flags
    push_u32(out, crc32_bytes(out, 20))   // header_crc32 over bytes [0,20)
    let mut leaves: [[int]] = []
    let mut mi = 0
    while mi < count {
        let tb = l_str_bytes(members[mi])
        let h = sha256_bytes(tb)
        leaves.push(h)
        push_all(out, h)
        push_u32(out, len(tb))
        push_all(out, tb)
        mi = mi + 1
    }
    push_all(out, limen_merkle_root(leaves))
    return out
}


// ── verify (spec §4): magic + version + header_crc32 + per-record hash +
//    trailing merkle root. Returns 1 iff every check passes, else 0. ──
pub fn limen_verify(bytes: [int]) -> int {
    let magic = [76, 73, 77, 69, 78, 0, 0, 0]
    let mut i = 0
    while i < 8 { if bytes[i] != magic[i] { return 0 } i = i + 1 }
    if l_rd16(bytes, 8) != 2 { return 0 }                 // version_major
    if crc32_bytes(bytes, 20) != l_rd32(bytes, 20) { return 0 }
    let count = l_rd32(bytes, 12)
    let mut off = 24
    let mut leaves: [[int]] = []
    let mut k = 0
    while k < count {
        let h = l_slice(bytes, off, off + 32); off = off + 32
        let alen = l_rd32(bytes, off); off = off + 4
        let tb = l_slice(bytes, off, off + alen); off = off + alen
        if l_bytes_eq(h, sha256_bytes(tb)) == 0 { return 0 }   // per-member integrity
        leaves.push(h)
        k = k + 1
    }
    let root = l_slice(bytes, off, off + 32)
    if l_bytes_eq(root, limen_merkle_root(leaves)) == 0 { return 0 }
    return 1
}


// ── unpack (spec §2,§5): .limen bytes -> [anchor_text]. Re-emit each member's
//    manifest text verbatim (caller re-indents 2 spaces as a nested @corpus
//    member). Pair with limen_verify for the integrity checks (spec §4). ──
pub fn limen_unpack(bytes: [int]) -> [string] {
    let count = l_rd32(bytes, 12)
    let mut off = 24
    let mut members: [string] = []
    let mut k = 0
    while k < count {
        off = off + 32                       // skip the per-record hash
        let alen = l_rd32(bytes, off); off = off + 4
        let tb = l_slice(bytes, off, off + alen); off = off + alen
        members.push(l_bytes_str(tb))
        k = k + 1
    }
    return members
}


// ── disk I/O (write_bytes / read_file_bytes builtins — NUL-safe) ──
pub fn limen_write(path: string, members: [string]) -> int {
    let b = limen_pack(members)
    write_bytes(path, b)
    return len(b)
}
pub fn limen_read(path: string) -> [string] {
    return limen_unpack(read_file_bytes(path))
}
